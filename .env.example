# Copy to `.env` or `.env.local` and adjust values.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Public URL of the Express + Better Auth backend (no trailing slash).
# Must match backend PORT (e.g. PORT=3001 → http://localhost:3001). Same value as auth client baseURL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# This Next.js app origin (no trailing slash). OAuth redirects and customer receipt links
# (/receipt/..., QR, share). On Vercel Production set this to your real domain
# (e.g. https://getsafereceipts.com) so shared links are not *.vercel.app preview URLs.
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override only the receipt viewer / QR / share base (defaults to getsafereceipts.com on Vercel).
# NEXT_PUBLIC_RECEIPT_VIEWER_ORIGIN=https://getsafereceipts.com

# Google Analytics 4 — Web data stream Measurement ID (format G-XXXXXXXXXX).
# Set in Vercel Production/Preview env. Omit locally if you do not want hits while developing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KJ73V1WSDH
#
# GA4 admin (once connected):
# - Admin → Data streams → your stream → Enhanced measurement: enable Scrolls (~90% depth), etc.
# - Admin → Events: mark conversions (e.g. sign_up) for funnel reports.
# - Acquisition: UTM params on campaign links (?utm_source=…&utm_medium=…) show in Traffic acquisition.
